# Copie este arquivo para .env e preencha os valores.
# NUNCA commite o arquivo .env.

SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=eyJ...
# A SERVICE_ROLE KEY nunca vai para o front nem para o Lovable.
# Use-a APENAS em scripts locais de migração ou em segredos do Supabase.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Gerado com: openssl rand -hex 32
GREENN_WEBHOOK_TOKEN=

# ID do produto Rara IA na Greenn
GREENN_PRODUCT_ID=
