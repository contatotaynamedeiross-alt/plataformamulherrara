# Segredos das Edge Functions (supabase secrets set NOME=valor).
# Nunca coloque valores reais neste arquivo nem em nenhum arquivo do Git.

# Token do webhook da Asaas: openssl rand -hex 32
ASAAS_WEBHOOK_TOKEN=
# IDs das assinaturas da Asaas que liberam acesso à Rara IA, separados por vírgula.
# Deixe em branco para aceitar todas as assinaturas (plataforma de produto único).
ASAAS_SUBSCRIPTION_IDS=
# Endereço do app (para onde o convite leva)
APP_URL=https://app.raraia.com.br
# Domínios que podem chamar as funções a partir do navegador
ALLOWED_ORIGINS=https://app.raraia.com.br

# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY já são fornecidos pelo Supabase às funções.
